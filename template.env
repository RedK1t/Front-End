# Front-End (Vite) environment — these are baked into the bundle at BUILD time.
# Copy this file to .env and fill in real values. .env is the single source of truth.

# Service endpoints (point at wherever each backend is reachable from the browser)
VITE_proxy_websocket_url=ws://localhost:5050/ws
VITE_subdomains_websocket_url=ws://localhost:3003/ws/enumerate
VITE_openPorts_REST_url=http://localhost:3004/scan
VITE_endpoints_REST_url=http://localhost:3005/scan
VITE_web_check_url=http://localhost:3001/api
VITE_web_check_local_url=http://localhost:3001/api
VITE_DEV_whois=http://localhost:3000
VITE_scanner_websocket_url=ws://localhost:3006
VITE_generateReport_REST_url=http://localhost:3002/api

# Public keys
VITE_LOGO_DEV_PUBLIC_KEY=your_logo_dev_public_key_here

# Supabase
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_publishable_key_here

# Secrets — fill in your own keys (do NOT commit real values)
VITE_GROQ_API_KEY=your_groq_api_key_here

# System prompt for the in-app assistant
VITE_SYSTEM_PROMPT=
